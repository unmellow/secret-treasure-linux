#!/bin/sh
# Wine registers a binfmt for every MZ file. APE binaries start with MZ, so
# `./secret-treasure.com` on Manjaro/Arch with Wine installed is stolen by
# Wine and sockets die (Firefox: NS_ERROR_NET_EMPTY_RESPONSE).
# Starting via the shell polyglot bypasses that.
set -e
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ape="$here/secret-treasure.com"
if [ ! -f "$ape" ]; then
  echo "missing $ape" >&2
  exit 1
fi
case "$(uname -s)" in
  Linux)
    exec sh "$ape" "$@"
    ;;
  *)
    exec "$ape" "$@"
    ;;
esac
