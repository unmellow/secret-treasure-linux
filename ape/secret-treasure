#!/bin/sh
# Wine registers a binfmt for every MZ file. APE binaries start with MZ, so
# `./secret-treasure.com` on Manjaro/Arch with Wine installed is stolen by
# Wine and sockets die (Firefox: NS_ERROR_NET_EMPTY_RESPONSE).
# Starting via the shell polyglot bypasses that.
#
# If http://127.0.0.1:19996/ is already up, just open a browser and exit
# instead of failing the bind.
set -e
PORT=19996
URL="http://127.0.0.1:${PORT}/"
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ape="$here/secret-treasure.com"

open_url() {
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL" >/dev/null 2>&1 || true
  elif command -v open >/dev/null 2>&1; then
    open "$URL" >/dev/null 2>&1 || true
  else
    echo "Open $URL in your browser" >&2
  fi
}

port_bound() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c "import socket;s=socket.socket();s.settimeout(0.35);r=s.connect_ex(('127.0.0.1',$PORT));s.close();raise SystemExit(0 if r==0 else 1)" 2>/dev/null
  elif command -v nc >/dev/null 2>&1; then
    nc -z -w 1 127.0.0.1 "$PORT" >/dev/null 2>&1
  else
    return 1
  fi
}

if port_bound; then
  echo "Secret Treasure already at $URL — opening browser"
  open_url
  exit 0
fi

if [ ! -f "$ape" ]; then
  echo "missing $ape" >&2
  exit 1
fi
case "$(uname -s)" in
  Linux)
    exec sh "$ape" "$@"
    ;;
  *)
    exec "$ape" "$@"
    ;;
esac
